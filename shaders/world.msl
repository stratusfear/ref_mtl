//
// world.msl - W3 world-rendering shaders for the Metal 4 refresher.
//
// Compiled at runtime by the MTL4Compiler from the embedded source
// (see src/files/mtl_shaders.c, generated from this file).
//
// Vertex data comes from [[stage_in]] (bound through the vertex-stage
// argument table at buffer index 0); everything else is delivered
// through an MTL4ArgumentTable:
//   vertex stage : [[buffer(1)]] = WorldUbo
//   fragment     : [[texture(0)]] = surface (and [[texture(1)]] lightmap
//                  for the lmap path), [[buffer(0)]] = WorldUbo
//
// The WorldUbo layout must match world_ubo_t in mtl.h exactly.

#include <metal_stdlib>
using namespace metal;

struct WorldUbo
{
    float4x4 viewproj;		// @0
    float4x4 model;		// @64
    float4   color;		// @128
    float    gamma;		// @144
    float    viewLightmaps;	// @148
};

// MSL 3.x removed the coord argument from the sampler constructor.
constexpr sampler world_sampler(address::repeat, filter::linear, mip_filter::linear);
constexpr sampler world_lmap_sampler(address::clamp_to_edge, filter::linear);
constexpr sampler present_sampler(address::clamp_to_edge, filter::nearest);

//==================================================================
// Plain (unlightmapped) world polys. World-space vertices for the
// world model (identity model matrix); bmodel water and flowing
// surfaces pass a real model matrix.
//==================================================================

struct world_plain_in
{
    float3 position [[attribute(0)]];
    float2 uv      [[attribute(1)]];
};

struct world_vertex_out
{
    float4 position [[position]];
    float2 uv;
};

vertex world_vertex_out
world_plain_vertex(world_plain_in in [[stage_in]],
                  const device WorldUbo *ubo [[buffer(1)]])
{
    world_vertex_out out;
    out.position = ubo->viewproj * (ubo->model * float4(in.position, 1.0));
    out.uv = in.uv;
    return out;
}

fragment float4
world_plain_fragment(world_vertex_out in [[stage_in]],
                     texture2d<float, access::sample> tex [[texture(0)]],
                     constant WorldUbo *ubo [[buffer(0)]])
{
    float4 c = tex.sample(world_sampler, in.uv) * ubo->color;
    c.rgb = pow(c.rgb, float3(ubo->gamma));
    return c;
}

//==================================================================
// Lightmapped world polys: viewproj * model * pos
//==================================================================

struct world_lmap_in
{
    float3 position     [[attribute(0)]];
    float2 uv          [[attribute(1)]];
    float2 lmapuv      [[attribute(2)]];
};

struct world_lmap_out
{
    float4 position [[position]];
    float2 uv;
    float2 lmapuv;
    float  viewLightmaps;
};

vertex world_lmap_out
world_lmap_vertex(world_lmap_in in [[stage_in]],
                 const device WorldUbo *ubo [[buffer(1)]])
{
    world_lmap_out out;
    out.position = ubo->viewproj * (ubo->model * float4(in.position, 1.0));
    out.uv = in.uv;
    out.lmapuv = in.lmapuv;
    out.viewLightmaps = ubo->viewLightmaps;
    return out;
}

fragment float4
world_lmap_fragment(world_lmap_out in [[stage_in]],
                    texture2d<float, access::sample> tex [[texture(0)]],
                    texture2d<float, access::sample> lmap [[texture(1)]],
                    constant WorldUbo *ubo [[buffer(0)]])
{
    float4 color = tex.sample(world_sampler, in.uv);
    float4 light = lmap.sample(world_lmap_sampler, in.lmapuv);
    return (1.0 - in.viewLightmaps) * color * light + in.viewLightmaps * light;
}

//==================================================================
// Sky: 20-byte vertices (pos3 + uv2), viewproj * model * pos, plain
// fragment (color = white).
//==================================================================

vertex world_vertex_out
world_sky_vertex(world_plain_in in [[stage_in]],
                const device WorldUbo *ubo [[buffer(1)]])
{
    world_vertex_out out;
    out.position = ubo->viewproj * (ubo->model * float4(in.position, 1.0));
    out.uv = in.uv;
    return out;
}

//==================================================================
// Dynamic light billboard quads. 24-byte vertices (pos3 + color3),
// viewproj * pos, per-vertex color passed through to the fragment.
// The pipeline is additive with depth writes disabled and front-face
// culling (encoder state, see R_RenderDlight); the fragment stage has
// no resource bindings of its own.
//==================================================================

struct DlightUbo
{
    float4x4 viewproj;		// @0
};

struct dlight_in
{
    float3 position [[attribute(0)]];
    float3 color   [[attribute(1)]];
};

struct dlight_out
{
    float4 position [[position]];
    float3 color;
};

vertex dlight_out
dlight_vertex(dlight_in in [[stage_in]],
              const device DlightUbo *ubo [[buffer(1)]])
{
    dlight_out out;
    out.position = ubo->viewproj * float4(in.position, 1.0);
    out.color = in.color;
    return out;
}

fragment float4
dlight_fragment(dlight_out in [[stage_in]])
{
    return float4(in.color, 1.0);
}

//==================================================================
// View flash (R_PolyBlend): a full-screen clip-space quad with a
// uniform RGBA color taken from v_blend (pain / damage feedback).
// The vertices are already NDC, so no matrix is needed; the color
// arrives in a small UBO and is passed through to the fragment.
//==================================================================

struct FlashUbo
{
    float4 color;		// @0
};

struct flash_in
{
    float2 position [[attribute(0)]];
};

struct flash_out
{
    float4 position [[position]];
    float4 color;
};

vertex flash_out
flash_vertex(flash_in in [[stage_in]],
             const device FlashUbo *ubo [[buffer(1)]])
{
    flash_out out;
    out.position = float4(in.position, 0.0, 1.0);
    out.color = ubo->color;
    return out;
}

fragment float4
flash_fragment(flash_out in [[stage_in]])
{
    return in.color;
}

//==================================================================
// Alias models (MD2 / SP2). The CPU lerps the two animation frames
// into world-space positions and fan-expands the strip/fan glcmds
// into a triangle list of 36-byte vertices (pos3 + uv2 + color4);
// the color is shadedots * shadelight per vertex (alpha carries the
// RF_TRANSLUCENT blend factor). The UBO holds the entity model and
// view-projection matrices plus a texture on/off flag - shells
// (RF_SHELL_*) draw untextured, tinted by the vertex color only.
//==================================================================

struct AliasUbo
{
    float4x4 viewproj;		// @0
    float4x4 model;		// @64
    float    textured;		// @128
};

struct alias_in
{
    float3 position [[attribute(0)]];
    float2 uv      [[attribute(1)]];
    float4 color  [[attribute(2)]];
};

struct alias_out
{
    float4 position [[position]];
    float2 uv;
    float4 color;
};

vertex alias_out
alias_vertex(alias_in in [[stage_in]],
             const device AliasUbo *ubo [[buffer(1)]])
{
    alias_out out;
    out.position = ubo->viewproj * (ubo->model * float4(in.position, 1.0));
    out.uv = in.uv;
    out.color = in.color;
    return out;
}

fragment float4
alias_fragment(alias_out in [[stage_in]],
               texture2d<float, access::sample> tex [[texture(0)]],
               constant AliasUbo *ubo [[buffer(0)]])
{
    if (ubo->textured > 0.5)
        return tex.sample(world_sampler, in.uv) * in.color;

    return in.color;	// shell: solid vertex color, no texture
}

//==================================================================
// Sprites (mod_sprite): camera-facing billboards. The CPU writes six
// world-space 36-byte vertices (pos3 + uv2 + color4, color = white *
// alpha) per sprite, so no model matrix is needed - just viewproj.
// The fragment discards nearly transparent pixels and gamma-corrects,
// matching ref_vk's sprite.vert / basic.frag pair.
//==================================================================

struct SpriteUbo
{
    float4x4 viewproj;		// @0
    float    gamma;		// @64
};

vertex alias_out
sprite_vertex(alias_in in [[stage_in]],
              const device SpriteUbo *ubo [[buffer(1)]])
{
    alias_out out;
    out.position = ubo->viewproj * float4(in.position, 1.0);
    out.uv = in.uv;
    out.color = in.color;
    return out;
}

fragment float4
sprite_fragment(alias_out in [[stage_in]],
                texture2d<float, access::sample> tex [[texture(0)]],
                constant SpriteUbo *ubo [[buffer(0)]])
{
    float4 c = tex.sample(world_sampler, in.uv) * in.color;
    if (c.a < 0.0666)
        discard_fragment();
    c.rgb = pow(c.rgb, float3(ubo->gamma));
    return c;
}

//==================================================================
// Particles: two paths mirroring ref_vk's vk_custom_particles.
// Textured mode (mtl_custom_particles 0 or 2): one triangle per
// particle from three world-space 36-byte vertices (pos3 + uv2 +
// color4, uvs centered on the dot texture), drawn with the sprite
// vertex function (viewproj only) and a basic.frag-style fragment
// that discards alpha < 0.5 and gamma-corrects. Point mode (1,
// default): one vertex per particle; the vertex shader computes the
// attenuated point size and the fragment discards the square corners
// of the point sprite (no texture, no gamma - ref_vk parity).
//==================================================================

fragment float4
particle_fragment(alias_out in [[stage_in]],
                  texture2d<float, access::sample> tex [[texture(0)]],
                  constant SpriteUbo *ubo [[buffer(0)]])
{
    float4 c = tex.sample(world_sampler, in.uv) * in.color;
    if (c.a < 0.5)
        discard_fragment();
    c.rgb = pow(c.rgb, float3(ubo->gamma));
    return c;
}

struct ParticlePointUbo
{
    float4x4 viewproj;		// @0
    float    pointSize;		// @64
    float    pointScale;
    float    minPointSize;
    float    maxPointSize;
    float    att_a;
    float    att_b;
    float    att_c;
};

struct particle_point_out
{
    float4 position [[position]];
    float  point_size [[point_size]];
    float4 color;
};

vertex particle_point_out
particle_point_vertex(alias_in in [[stage_in]],
                      const device ParticlePointUbo *ubo [[buffer(1)]])
{
    particle_point_out out;
    float4 p = ubo->viewproj * float4(in.position, 1.0);
    float dist_atten = ubo->pointScale / (ubo->att_a + ubo->att_b * p.w + ubo->att_c * p.w * p.w);
    out.point_size = clamp(ubo->pointScale * ubo->pointSize * sqrt(dist_atten),
                           ubo->minPointSize, ubo->maxPointSize);
    out.position = p;
    out.color = in.color;
    return out;
}

fragment float4
particle_point_fragment(particle_point_out in [[stage_in]],
                        float2 point_coord [[point_coord]])
{
    float2 cxy = 2.0 * point_coord - 1.0;
    if (dot(cxy, cxy) > 1.0)
        discard_fragment();
    return in.color;
}

//==================================================================
// 2D UI (RE_Draw_*): screen-space quads for the console, menus, HUD
// and raw stretched surfaces. The geometry is a static full-screen
// quad (CPU-expanded to a triangle list, like the flash quad); every
// draw writes one UiUbo into the world UBO ring that positions the
// quad in NDC (offset/scale) and carries, per path, the uv transform
// (tex), the color (color/tint) and the gamma exponent (tex/tint).
//
// NDC math: vPos = pos * scale - (1 - scale), as in ref_vk basic.vert,
// but the final mapping differs per API. Vulkan NDC is y-down
// (top-left at (-1,-1)), so gl_Position.y = vPos.y + offset.y * 2 puts
// a quake rect (y,h) at screen rows [y, y+h]. Metal NDC is y-up
// (OpenGL-style, bottom-left at (-1,-1) per the MSL spec), so the same
// rect maps to ndc.y = -vPos.y - offset.y * 2: row = (1-ndc.y)/2*H.
// The uv pairing in the static corner data is unchanged (pos.y=-1 still
// carries v=0, the top of the picture). The color path intentionally
// accepts oversized scales (FadeScreen passes raw pixel dimensions) -
// the quad is clipped to the screen by the rasterizer.
//==================================================================

struct UiUbo
{
    float2 offset;		// @0
    float2 scale;		// @8
    float2 uv_offset;	// @16
    float2 uv_scale;	// @24
    float4 color;		// @32
    float  gamma;		// @48
};

struct ui_tex_in
{
    float2 position [[attribute(0)]];
    float2 uv      [[attribute(1)]];
};

struct ui_color_in
{
    float2 position [[attribute(0)]];
};

struct ui_out
{
    float4 position [[position]];
    float2 uv;
    float4 color;
};

vertex ui_out
ui_tex_vertex(ui_tex_in in [[stage_in]],
              const device UiUbo *ubo [[buffer(1)]])
{
    ui_out out;
    float2 vPos = in.position * ubo->scale - (float2(1.0) - ubo->scale);
    out.position = float4(vPos.x + ubo->offset.x * 2.0,
                          -vPos.y - ubo->offset.y * 2.0, 0.0, 1.0);
    out.uv = in.uv * ubo->uv_scale + ubo->uv_offset;
    out.color = float4(1.0, 1.0, 1.0, 1.0);
    return out;
}

vertex ui_out
ui_color_vertex(ui_color_in in [[stage_in]],
                const device UiUbo *ubo [[buffer(1)]])
{
    ui_out out;
    float2 vPos = in.position * ubo->scale - (float2(1.0) - ubo->scale);
    out.position = float4(vPos.x + ubo->offset.x * 2.0,
                          -vPos.y - ubo->offset.y * 2.0, 0.0, 1.0);
    out.uv = float2(0.0);
    out.color = ubo->color;
    return out;
}

fragment float4
ui_tex_fragment(ui_out in [[stage_in]],
                texture2d<float, access::sample> tex [[texture(0)]],
                constant UiUbo *ubo [[buffer(0)]])
{
    float4 c = tex.sample(world_sampler, in.uv) * in.color;
    if (c.a < 0.666)
        discard_fragment();
    c.rgb = pow(c.rgb, float3(ubo->gamma));
    return c;
}

fragment float4
ui_tint_fragment(ui_out in [[stage_in]],
                 texture2d<float, access::sample> tex [[texture(0)]],
                 constant UiUbo *ubo [[buffer(0)]])
{
    float4 c = tex.sample(world_sampler, in.uv) * in.color;
    if (c.a < 0.666)
        discard_fragment();
    c.rgb = pow(c.rgb, float3(ubo->gamma)) * ubo->color.rgb;
    return c;
}

fragment float4
ui_color_fragment(ui_out in [[stage_in]])
{
    return in.color;
}

//==================================================================
// W6: Present pass. The world and UI passes render into an offscreen
// scene texture; this final pass draws it to the layer drawable as a
// single full-screen quad, so the drawable is touched by exactly one
// render pass and only ever as a render target - the mode
// framebufferOnly = YES requires and optimizes for. The quad reuses
// the ui_color static full-screen corners (no UBO). uv is derived
// from position: Metal NDC is y-up while texcoord row 0 is the top
// (ndc.y = -1 maps to texel row H-1), and at 1:1 size the nearest
// sampling with uv = (pos * 0.5 + 0.5)-with-flip is an exact
// identity texel->pixel copy.
//==================================================================

struct present_in
{
    float2 position [[attribute(0)]];
};

vertex ui_out
present_vertex(present_in in [[stage_in]])
{
    ui_out out;
    out.position = float4(in.position, 0.0, 1.0);
    out.uv = float2(in.position.x * 0.5 + 0.5, 0.5 - in.position.y * 0.5);
    out.color = float4(1.0);
    return out;
}

fragment float4
present_fragment(ui_out in [[stage_in]],
                 texture2d<float, access::sample> scene [[texture(0)]])
{
    return scene.sample(present_sampler, in.uv);
}

// ---------------------------------------------------------------------------
// W6b: underwater world-warp pass, the ref_vk world_warp.vert/frag port.
// Full-screen quad (same ui_colorvert corners as the present pass) that
// samples the world color texture and, while the view is submerged, applies
// the sine distortion inside the world-view rectangle. Also handles the
// pixel-size upscale restore (pixelSize > 1) for later parity work.
// uv maps the quad to top-row-first texture space, matching Metal render
// target orientation, so fragCoord-equivalent == uv * scrSize.
// ---------------------------------------------------------------------------

struct warp_ubo_t
{
    float    time;      // @0  (underwater time; 0 = no warp)
    float    scale;     // @4  (viewsize / 100)
    float    scrWidth;  // @8
    float    scrHeight; // @12
    float    pixelSize; // @16 (>= 1)
    float    refdefX;   // @20 world-view rect in device pixels
    float    refdefY;   // @24
    float    refdefW;   // @28
    float    refdefH;   // @32
};

struct warp_out
{
    float4 position [[position]];
    float2 uv;
};

vertex warp_out
warp_vertex(present_in in [[stage_in]])
{
    warp_out out;
    out.position = float4(in.position, 0.0, 1.0);
    out.uv = float2(in.position.x * 0.5 + 0.5, 0.5 - in.position.y * 0.5);
    return out;
}

fragment float4
warp_fragment(warp_out in [[stage_in]],
              constant warp_ubo_t &ubo [[buffer(0)]],
              texture2d<float, access::sample> scene [[texture(0)]])
{
    const float PI = 3.14159265;
    float2 scrSize = float2(ubo.scrWidth, ubo.scrHeight);
    float2 fragCoord = in.uv * scrSize;
    float2 uv = in.uv;

    if (ubo.time > 0 && fragCoord.x > ubo.refdefX && fragCoord.x < ubo.refdefX + ubo.refdefW &&
        fragCoord.y > ubo.refdefY && fragCoord.y < ubo.refdefY + ubo.refdefH)
    {
        float sx = ubo.scale - abs(ubo.scrWidth  / 2.0 - fragCoord.x) * 2.0 / ubo.scrWidth;
        float sy = ubo.scale - abs(ubo.scrHeight / 2.0 - fragCoord.y) * 2.0 / ubo.scrHeight;
        float xShift = 2.0 * ubo.time + uv.y * PI * 10;
        float yShift = 2.0 * ubo.time + uv.x * PI * 10;
        uv += float2(sin(xShift) * sx, sin(yShift) * sy) * 0.00666;
    }

    // The GLSL original clamps in pixel space and samples with
    // textureLod(); Metal's sample() wants normalized coords, so the
    // texel-center clamp is expressed in normalized units here. For
    // pixelSize == 1 this is exactly uv clamped to the half-texel border,
    // i.e. a pixel-identical copy.
    uv /= ubo.pixelSize;
    float2 h = float2(0.5) / scrSize;
    float2 lo = h * ubo.pixelSize;
    float2 hi = float2(1.0) - lo;
    uv = clamp(uv, lo, hi);
    return scene.sample(present_sampler, uv);
}
