//
// quad.msl - W2 test shaders: a full-screen textured quad.
//
// Compiled at runtime by the MTL4Compiler from the embedded source
// (see src/files/mtl_shaders.c, generated from this file).
//
// The vertex input layout must match the MTLVertexDescriptor built in
// mtl_main.m:
//   attribute(0) = float3 position (clip-space x, y; z unused)
//   attribute(1) = float2 uv       (0,0 top-left -> 1,1 bottom-right)
//
#include <metal_stdlib>
using namespace metal;

struct quad_vertex_in
{
    float3 position [[attribute(0)]];
    float2 uv      [[attribute(1)]];
};

struct quad_vertex_out
{
    float4 position [[position]];
    float2 uv;
};

vertex quad_vertex_out
quad_vertex(quad_vertex_in in [[stage_in]])
{
    quad_vertex_out out;
    out.position = float4(in.position.xy, 0.0, 1.0);
    out.uv = in.uv;
    return out;
}

// Nearest so the checker cells stay crisp for the pixel check.
// MSL 3.x removed the coord argument from the sampler constructor.
constexpr sampler quad_sampler(address::clamp_to_edge,
                              filter::nearest);

fragment float4
quad_fragment(quad_vertex_out in [[stage_in]],
              texture2d<float, access::sample> tex [[texture(0)]])
{
    return tex.sample(quad_sampler, in.uv);
}
